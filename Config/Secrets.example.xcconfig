// Copy to Secrets.xcconfig (gitignored) and fill in values from
// Supabase dashboard → Project Settings → API Keys.
// Use only the *publishable* key here – never the secret key.
// `$()` keeps `//` from being parsed as a comment.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxx

// YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials).
// Restrict it: Application restriction "iOS apps" with bundle id webpulse.rabbithole,
// API restriction "YouTube Data API v3". Leave empty to disable videos.
YOUTUBE_API_KEY =
